# Public browser configuration. These values are embedded in the Vite bundle.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public-first launch gates. Enable only after the corresponding production
# services and release checks are complete.
VITE_BASIC_ONBOARDING_ENABLED=false
VITE_MEMBER_PLATFORM_ENABLED=false
VITE_COMPONENT_REQUESTS_ENABLED=false

# Keep false until the Google provider, OAuth client and callback checks pass in Supabase.
VITE_GOOGLE_AUTH_ENABLED=false

# Optional local override for links generated outside the browser.
VITE_SITE_URL=http://localhost:4173

# Public Cloudflare Turnstile site key for /components/request.
# Keep TURNSTILE_SECRET_KEY and email-provider credentials in Supabase secrets.
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Test-only. Never enable on a production build.
# VITE_DEMO_MODE=true
