/*
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(self), geolocation=(), microphone=(), payment=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-Permitted-Cross-Domain-Policies: none

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/app-shell
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, follow

/app-shell.html
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, follow

/404.html
  X-Robots-Tag: noindex, follow

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/auth/course-session
  ! X-Frame-Options
  Cache-Control: private, no-store
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'none'; script-src 'self'; connect-src https://uxfhdfagrmaeyuaipaar.supabase.co; frame-ancestors https://courses.armatureailabs.com; base-uri 'none'; form-action 'none'

/auth/course-session.html
  ! X-Frame-Options
  Cache-Control: private, no-store
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'none'; script-src 'self'; connect-src https://uxfhdfagrmaeyuaipaar.supabase.co; frame-ancestors https://courses.armatureailabs.com; base-uri 'none'; form-action 'none'
